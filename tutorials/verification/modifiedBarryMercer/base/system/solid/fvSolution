FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    p_rgh
    {
        solver PBiCGStab;
        preconditioner DIC;
        tolerance 1e-12;
        relTol 0;
    }

    D
    {
        solver GAMG;
        tolerance 1e-12;
        relTol 0;
        smoother DICGaussSeidel;
        nCellsInCoarsestLevel 1;
    }
}

relaxationFactors
{
    fields
    {
        D 1;
        p_rgh 1;
    }
}
