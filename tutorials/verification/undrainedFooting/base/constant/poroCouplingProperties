FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object poroCouplingProperties;
}

poroSolidInterface poroSolid;
sharedMesh true;
porosityConstant true;
includeRelativeAcceleration false;

// impK/Kdr = 3(1-nu)/(1+nu) = 1.5 for nu=1/3.
fixedStressStabilScale 1.5;
pressureModeDiagnosticFields (checkerboardX checkerboardZ checkerboardXZ);

poroSolidCoeffs
{
    enabled true;
    iterations 600;
    infoFrequency 1;
    convergence
    {
        p_rgh max 1e-4;
        D max 1e-10;
    }
}

poroSolidStabCoeffs
{
    enabled true;
    iterations 600;
    infoFrequency 1;
    stabilizationType implicit;
    stabFactor 1;
    excludedCellZones ();
    convergence
    {
        p_rgh max 1e-4;
        D max 1e-10;
    }
}
