FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application poroMechanicalFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 100;
deltaT 10;
writeControl timeStep;
writeInterval 1;
purgeWrite 0;
writeFormat ascii;
writePrecision 12;
writeCompression off;
timeFormat general;
timePrecision 6;
runTimeModifiable false;
adjustTimeStep false;
