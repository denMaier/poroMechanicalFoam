FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object D;
}

dimensions [0 1 0 0 0 0 0];
internalField uniform (0 0 0);

boundaryField
{
    left
    {
        type fixedDisplacementZeroShear;
        value uniform (0 0 0);
    }
    bottom
    {
        type fixedDisplacementZeroShear;
        value uniform (0 0 0);
    }
    right
    {
        type poroTraction;
        total false;
        buoyancyIncluded true;
        traction uniform (0 0 0);
        pressure uniform 0;
        value uniform (0 0 0);
    }
    top
    {
        type fixedDisplacementZeroShear;
        displacementSeries
        {
            file "$FOAM_CASE/constant/topDisplacement.dat";
            outOfBounds clamp;
        }
        spatialScale uniform 1;
        value uniform (0 0 0);
    }
    frontAndBack
    {
        type empty;
    }
}
