FoamFile
{
    version 2.0;
    format ascii;
    class volVectorField;
    object D;
}

dimensions [0 1 0 0 0 0 0];
internalField uniform (0 0 0);

boundaryField
{
    "bottom|top"
    {
        type directionMixed;
        refValue uniform (0 0 0);
        refGradient uniform (0 0 0);
        valueFraction uniform (1 0 0 0 0 1);
        value uniform (0 0 0);
    }
    "left|right"
    {
        type directionMixed;
        refValue uniform (0 0 0);
        refGradient uniform (0 0 0);
        valueFraction uniform (0 0 0 1 0 1);
        value uniform (0 0 0);
    }
    frontAndBack
    {
        type empty;
    }
}
