FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}

scale 1;
a 1.0;
b 0.2;
t 0.01;
footingWidth 0.25;
nxFooting 20;
nxFree 60;
ny 1;
nz 16;

vertices
(
    (0 0 0)
    ($footingWidth 0 0)
    ($footingWidth $t 0)
    (0 $t 0)
    (0 0 $b)
    ($footingWidth 0 $b)
    ($footingWidth $t $b)
    (0 $t $b)
    ($a 0 0)
    ($a $t 0)
    ($a 0 $b)
    ($a $t $b)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nxFooting $ny $nz) simpleGrading (1 1 1)
    hex (1 8 9 2 5 10 11 6) ($nxFree $ny $nz) simpleGrading (1 1 1)
);

edges ();

boundary
(
    left { type patch; faces ((0 3 7 4)); }
    right { type patch; faces ((8 10 11 9)); }
    bottom { type patch; faces ((0 1 2 3) (1 8 9 2)); }
    topLoaded { type patch; faces ((4 7 6 5)); }
    topFree { type patch; faces ((5 6 11 10)); }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 4 5 1)
            (3 2 6 7)
            (1 5 10 8)
            (2 9 11 6)
        );
    }
);

mergePatchPairs ();
